*.dylib

# Build caches
.cache/

memory/test_credentials.md

# Mobile development
android-sdk/

# Environment and credential files (deduplicated)
# NOTE: .env files MUST be tracked for Emergent Kubernetes deployment — they
# get auto-injected during the deploy process. Only ignore non-tracked credentials.
credentials.json
*.pem
*.key
.credentials


# EAS Build artifacts & native eject output
.eas/
*.apk
*.aab
*.ipa
ios/
android/
expo-env.d.ts

# Mobile metro / Expo
.expo/
.expo-shared/

# Backend upload directory (large binary blobs)
backend/uploads/audio/*
!backend/uploads/audio/.gitkeep

# Memory / PRD docs (often contain sensitive workspace data)
memory/PRD.md
app/memory/PRD.md
app/memory/test_credentials.md
